module App

using GenieFramework
using DataFrames, CSV
using PlotlyBase
@genietools

const df = CSV.read("to_interactive.csv", DataFrame)
const COUNTRY_LIST = unique(df.country_name)

const ENERGY_MAPPING = Dict(
    "Total Solar"         => :total_solar,
    "Total Biogas"        => :total_biogas,
    "Total Geothermal"    => :total_geo,
    "Total Hydro"         => :total_hydro,
    "Total Biofuels"      => :total_biofuels,
    "Total Marine"        => :total_marine,
    "Total Modern Bio"    => :total_modern_bio,
    "Total Renewable"     => :total_renewable,
    "Total Traditional"   => :total_trad_bio_mass,
    "Total Waste"         => :total_waste_energy,
    "Total Wind"          => :total_wind_energy
)

const CLEAN_LABELS = collect(keys(ENERGY_MAPPING))

const ENERGY_DESCRIPTIONS = Dict(
    "Total Solar"         => "Total electricity generated from solar photovoltaic (PV) systems and concentrated solar power plants, measured in Terajoules.",
    "Total Biogas"        => "Energy derived from the anaerobic digestion of organic matter, including landfill gas, sewage gas, and agricultural biofuels.",
    "Total Geothermal"    => "Electricity and direct heat generated by tapping into deep underground thermal reservoirs.",
    "Total Hydro"         => "Energy produced from flowing water moving through turbines, including large-scale dams and run-of-river facilities.",
    "Total Biofuels"      => "Liquid fuels derived from biomass, such as bioethanol and biodiesel, typically used in transport sectors.",
    "Total Marine"        => "Energy captured from ocean movements, including wave action, tidal currents, and ocean thermal energy conversion (OTEC).",
    "Total Modern Bio"    => "Efficiently processed solid or gas biomass used in modern heating and power plants (excluding traditional wood/charcoal cooking).",
    "Total Renewable"     => "The aggregate sum of all renewable energy consumption metrics across the selected country's sectors.",
    "Total Traditional"   => "Solid biomass consumption, predominantly referring to wood, charcoal, and agricultural residue used for basic cooking and heating.",
    "Total Waste"         => "Energy recovered from the incineration of municipal solid waste and industrial waste streams.",
    "Total Wind"          => "Total wind power output generated from onshore and offshore wind farms using mechanical wind turbines."
)

@app begin
    @in selected_country::Vector{String} = ["United States", "China", "Australia"]
    @in energy_categories = CLEAN_LABELS[1] 
    
    @out countries = COUNTRY_LIST
    @out energy = CLEAN_LABELS              
    @out trace = PlotlyBase.AbstractTrace[]
    @out layout = PlotlyBase.Layout()
    @out table_data = DataTable()
    
    # 2. Declare a reactive output for the description text
    @out current_description = ""

    @onchange selected_country, energy_categories begin
        target_column = ENERGY_MAPPING[energy_categories]
        
        # 3. Update the descriptive text instantly on change
        current_description = ENERGY_DESCRIPTIONS[energy_categories]
        
        new_traces = PlotlyBase.AbstractTrace[]
        table_dfs = DataFrame[]
        
        for country in selected_country
            filtered_df = df[df.country_name .== country, :]
            if !isempty(filtered_df)
                push!(table_dfs, filtered_df[:, [:country_name, :yr, target_column]])
                push!(new_traces, scatter(
                    x = filtered_df.yr,
                    y = filtered_df[:, target_column],
                    mode = "lines+markers",
                    name = country
                ))
            end
        end
        
        trace = new_traces
        
        if !isempty(table_dfs)
            combined_df = reduce(vcat, table_dfs)
            rename!(combined_df, target_column => Symbol(energy_categories))
            table_data = DataTable(combined_df)
        else
            table_data = DataTable(DataFrame(Country=[], Year=[], Value=[]))
        end
        
        layout = PlotlyBase.Layout(
            title = attr(text = "$(energy_categories) Comparison"),
            xaxis = attr(title = "Year"),
            yaxis = attr(title = energy_categories)
        )
    end
end


function ui()
    row([
        # Sidebar for Controls (Left Side)
        cell(class="st-col col-4 st-module", [
            h1("Energy Analytics", class="text-h4 text-bold"),
            p("Compare energy metrics across multiple countries."),
            br(),
            
            p("Select Countries:"),
            Stipple.select(:selected_country, options=:countries, multiple=true),
            
            br(),
            
            p("Select an Energy Category:"),
            Stipple.select(:energy_categories, options=:energy),
            
            br(),
            p("Viewing **{{energy_categories}}** comparison."),
            
            # --- NEW: Lower Left Dynamic Info Spot ---
            br(),
            hr(),
            br(),
            Genie.Renderer.Html.div(class="bg-grey-2 q-pa-md rounded-borders", [
                h2("Metric Glossary", class="text-subtitle1 text-bold q-mt-none q-mb-sm"),
                p("{{current_description}}", class="text-body1 text-grey-9 text-justify")
            ])
            # -----------------------------------------
        ]),
        
        # Main Panel for Graph and Table stacked vertically (Right Side)
        cell(class="st-col col-8", [
            row([
                cell(class="col-12", [
                    plot(:trace, layout=:layout)
                ])
            ]),
            br(),
            row([
                cell(class="col-12 st-module", [
                    h2("Filtered Data View", class="text-h5 text-bold"),
                    Genie.Renderer.Html.table(:table_data, pagination=:flat)
                ])
            ])
        ])
    ])
end

@page("/", ui)
end
